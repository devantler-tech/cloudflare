bucket = "replace-with-state-bucket"
key    = "cloudflare/production.tfstate"
region = "auto"

endpoints = {
  s3 = "https://replace-with-account-id.r2.cloudflarestorage.com"
}

use_path_style              = true
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true

# Lock state with a conditional-write lock object beside the state object, so two
# operators or apply runs cannot plan from the same state generation and overwrite
# each other's updates. R2's PutObject accepts the If-None-Match header this uses.
use_lockfile = true

